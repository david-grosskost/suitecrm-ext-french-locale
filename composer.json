{
    "name": "david-grosskost/suitecrm-ext-french-locale",
    "description": "Compléments du pack de langue français et réglages français par défaut pour SuiteCRM 8.",
    "type": "suitecrm-extension",
    "license": "proprietary",
    "require": {
        "php": ">=8.4"
    },
    "require-dev": {
        "david-grosskost/suitecrm-devkit": "^0.29"
    },
    "autoload-dev": {
        "psr-4": {
            "SuiteCrmExt\\FrenchLocale\\": "legacy/include/french-locale/",
            "SuiteCrmExt\\FrenchLocale\\Tests\\": "tests/"
        }
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/david-grosskost/suitecrm-devkit",
            "no-api": true
        }
    ],
    "config": {
        "sort-packages": true
    }
}
